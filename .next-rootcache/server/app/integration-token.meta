{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/integration-token/layout,_N_T_/integration-token/page,_N_T_/integration-token/"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/integration-token/__PAGE__",
    "/integration-token",
    "/_index",
    "/_head"
  ]
}