file:/root/.gitconfig	user.name=ramdhaniit
file:/root/.gitconfig	user.email=ramdhaniit@gmail.comclear
file:/root/.gitconfig	safe.directory=/var/www/html/ekaplusAdmin
file:.git/config	core.repositoryformatversion=0
file:.git/config	core.filemode=true
file:.git/config	core.bare=false
file:.git/config	core.logallrefupdates=true
